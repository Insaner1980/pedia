<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Pedia.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pedia.Controls"
    xmlns:converters="using:Pedia.Converters"
    xmlns:views="using:Pedia.Views"
    Title="Pedia">

    <Grid x:Name="RootGrid" Background="{ThemeResource PediaApplicationBackgroundBrush}">
        <Grid.Resources>
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Background="{ThemeResource PediaTitleBarBackgroundBrush}"
            BorderBrush="{ThemeResource PediaSubtleDividerBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="14,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <Image Width="24" Height="24" Source="ms-appx:///Assets/PediaIconSource.png" Stretch="Uniform" />
                <TextBlock x:Uid="AppTitle" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel
                x:Name="TitleBarCommands"
                Grid.Column="2"
                Margin="0,0,4,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="2">
                <Button
                    x:Name="NewMenuButton"
                    x:Uid="NewMenuButton"
                    IsEnabled="{x:Bind ViewModel.CanUseTitleBarCommands, Mode=OneWay}"
                    Style="{StaticResource PediaTitleBarCommandStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock x:Uid="NewMenuButtonLabel" /></StackPanel>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Uid="NewArticleMenuItem" Command="{x:Bind ViewModel.NewArticleCommand}" Icon="Document">
                                <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="N" Modifiers="Control" /></MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="NewRootTopicMenuItem" Command="{x:Bind ViewModel.Topics.CreateRootTopicCommand}" Icon="Folder">
                                <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="N" Modifiers="Control,Shift" /></MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="NewChildTopicMenuItem" Command="{x:Bind ViewModel.Topics.CreateChildTopicCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="ImportButton" x:Uid="ImportButton" Command="{x:Bind ViewModel.ImportCommand}" IsEnabled="{x:Bind ViewModel.CanUseTitleBarCommands, Mode=OneWay}" Style="{StaticResource PediaTitleBarCommandStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE896;" FontSize="14" /><TextBlock x:Uid="ImportButtonLabel" /></StackPanel>
                </Button>
                <Button x:Name="RefreshButton" Command="{x:Bind ViewModel.RefreshCommand}" IsEnabled="{x:Bind ViewModel.CanUseTitleBarCommands, Mode=OneWay}" Style="{StaticResource PediaTitleBarCommandStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock x:Uid="RefreshButton" /></StackPanel>
                </Button>
                <Button x:Name="SettingsButton" Command="{x:Bind ViewModel.OpenSettingsCommand}" IsEnabled="{x:Bind ViewModel.CanUseTitleBarCommands, Mode=OneWay}" Style="{StaticResource PediaTitleBarCommandStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE713;" FontSize="14" /><TextBlock x:Uid="SettingsButton" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid
            x:Name="WorkspaceGrid"
            Grid.Row="1"
            Visibility="{Binding IsWorkspaceVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TopicPaneColumn" Width="290" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition x:Name="ArticlePaneColumn" Width="560" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <views:TopicPaneView
                x:Name="TopicPane"
                ViewModel="{x:Bind ViewModel.Topics}"
                CollapseRequested="OnCollapseTopicPane" />
            <controls:PaneSplitter
                x:Name="TopicSplitter"
                Grid.Column="1"
                TargetGrid="{Binding ElementName=WorkspaceGrid}"
                TargetColumn="0"
                Minimum="220"
                Maximum="430"
                AdjacentMinimum="450"
                WidthChanged="OnTopicPaneWidthChanged" />
            <views:ArticleBrowserView
                x:Name="ArticleBrowser"
                Grid.Column="2"
                ViewModel="{x:Bind ViewModel.Browser}" />
            <controls:PaneSplitter
                x:Name="ArticleSplitter"
                Grid.Column="3"
                TargetGrid="{Binding ElementName=WorkspaceGrid}"
                TargetColumn="2"
                Minimum="420"
                Maximum="760"
                AdjacentMinimum="450"
                WidthChanged="OnArticlePaneWidthChanged" />
            <views:ArticleDetailView
                x:Name="ArticleDetail"
                Grid.Column="4"
                ViewModel="{x:Bind ViewModel.Detail}"
                ScrollPositionChanged="OnArticleScrollPositionChanged" />

            <Button
                x:Name="ExpandTopicPaneButton"
                x:Uid="ExpandTopicPaneButton"
                Width="34"
                Height="72"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                Click="OnExpandTopicPane">
                <FontIcon Glyph="&#xE76C;" />
            </Button>
        </Grid>

        <views:SettingsView
            Grid.Row="1"
            ViewModel="{x:Bind ViewModel.Settings}"
            Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVisibility}}" />

        <Grid
            Grid.Row="2"
            Padding="16,0"
            Background="{ThemeResource PediaTitleBarBackgroundBrush}"
            BorderBrush="{ThemeResource PediaSubtleDividerBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE7F1;" FontSize="13" Foreground="{ThemeResource PediaSecondaryTextBrush}" />
                <TextBlock Text="{x:Bind ViewModel.ArticleCountText, Mode=OneWay}" Style="{StaticResource PediaMetadataTextStyle}" />
                <Border Width="1" Height="17" Background="{ThemeResource PediaSubtleDividerBrush}" />
                <TextBlock Text="{x:Bind ViewModel.TopicCountText, Mode=OneWay}" Style="{StaticResource PediaMetadataTextStyle}" />
                <Border Width="1" Height="17" Background="{ThemeResource PediaSubtleDividerBrush}" />
                <TextBlock Text="{x:Bind ViewModel.ResultCountText, Mode=OneWay}" Style="{StaticResource PediaMetadataTextStyle}" />
                <Border Width="1" Height="17" Background="{ThemeResource PediaSubtleDividerBrush}" />
                <TextBlock Text="{x:Bind ViewModel.LastImportText, Mode=OneWay}" Style="{StaticResource PediaMetadataTextStyle}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock x:Uid="ImportInProgressText" VerticalAlignment="Center" Style="{StaticResource PediaMetadataTextStyle}" />
                    <Button x:Uid="CancelImportButton" Command="{x:Bind ViewModel.CancelImportCommand}" Style="{StaticResource PediaToolbarButtonStyle}" />
                    <Border Width="1" Height="17" Background="{ThemeResource PediaSubtleDividerBrush}" />
                </StackPanel>
                <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="{ThemeResource PediaSecondaryTextBrush}" />
                <TextBlock Text="{x:Bind ViewModel.SearchIndexStateText, Mode=OneWay}" Style="{StaticResource PediaMetadataTextStyle}" />
                <Border Width="1" Height="17" Background="{ThemeResource PediaSubtleDividerBrush}" />
                <TextBlock Text="{x:Bind ViewModel.DatabaseStateText, Mode=OneWay}" Style="{StaticResource PediaMetadataTextStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Background="#B8000000" Visibility="{Binding IsInitializing, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <ProgressRing Width="36" Height="36" IsActive="{x:Bind ViewModel.IsInitializing, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.InitializationMessage, Mode=OneWay}" Style="{StaticResource PediaMetadataTextStyle}" />
            </StackPanel>
        </Grid>

        <InfoBar
            Grid.Row="1"
            Margin="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            IsOpen="{x:Bind ViewModel.IsInfoBarOpen, Mode=TwoWay}"
            IsClosable="True"
            Message="{x:Bind ViewModel.InfoBarMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.InfoBarSeverity, Mode=OneWay}" />

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnNewArticleAccelerator" />
            <KeyboardAccelerator Key="N" Modifiers="Control,Shift" Invoked="OnNewTopicAccelerator" />
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnSearchAccelerator" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchAccelerator" />
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnSaveAccelerator" />
            <KeyboardAccelerator Key="F2" Invoked="OnRenameTopicAccelerator" />
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackAccelerator" />
        </Grid.KeyboardAccelerators>
    </Grid>
</Window>
