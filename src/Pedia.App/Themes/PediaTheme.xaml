<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="PediaApplicationBackgroundColor">#FF0A0A0A</Color>
    <Color x:Key="PediaTitleBarBackgroundColor">#FF0E0E0E</Color>
    <Color x:Key="PediaPrimaryPaneColor">#FF121212</Color>
    <Color x:Key="PediaSecondarySurfaceColor">#FF161616</Color>
    <Color x:Key="PediaElevatedSurfaceColor">#FF1B1B1B</Color>
    <Color x:Key="PediaPointerOverColor">#FF222222</Color>
    <Color x:Key="PediaSelectedColor">#FF2A2A2A</Color>
    <Color x:Key="PediaPressedColor">#FF323232</Color>
    <Color x:Key="PediaPrimaryBorderColor">#FF323232</Color>
    <Color x:Key="PediaSubtleDividerColor">#FF2A2A2A</Color>
    <Color x:Key="PediaPrimaryTextColor">#FFF4F4F4</Color>
    <Color x:Key="PediaSecondaryTextColor">#FFBABABA</Color>
    <Color x:Key="PediaMutedTextColor">#FF888888</Color>
    <Color x:Key="PediaDisabledTextColor">#FF636363</Color>
    <Color x:Key="PediaFocusColor">#FFD8D8D8</Color>

    <SolidColorBrush x:Key="PediaApplicationBackgroundBrush" Color="{StaticResource PediaApplicationBackgroundColor}" />
    <SolidColorBrush x:Key="PediaTitleBarBackgroundBrush" Color="{StaticResource PediaTitleBarBackgroundColor}" />
    <SolidColorBrush x:Key="PediaPrimaryPaneBrush" Color="{StaticResource PediaPrimaryPaneColor}" />
    <SolidColorBrush x:Key="PediaSecondarySurfaceBrush" Color="{StaticResource PediaSecondarySurfaceColor}" />
    <SolidColorBrush x:Key="PediaElevatedSurfaceBrush" Color="{StaticResource PediaElevatedSurfaceColor}" />
    <SolidColorBrush x:Key="PediaPointerOverBrush" Color="{StaticResource PediaPointerOverColor}" />
    <SolidColorBrush x:Key="PediaSelectedBrush" Color="{StaticResource PediaSelectedColor}" />
    <SolidColorBrush x:Key="PediaPressedBrush" Color="{StaticResource PediaPressedColor}" />
    <SolidColorBrush x:Key="PediaPrimaryBorderBrush" Color="{StaticResource PediaPrimaryBorderColor}" />
    <SolidColorBrush x:Key="PediaSubtleDividerBrush" Color="{StaticResource PediaSubtleDividerColor}" />
    <SolidColorBrush x:Key="PediaPrimaryTextBrush" Color="{StaticResource PediaPrimaryTextColor}" />
    <SolidColorBrush x:Key="PediaSecondaryTextBrush" Color="{StaticResource PediaSecondaryTextColor}" />
    <SolidColorBrush x:Key="PediaMutedTextBrush" Color="{StaticResource PediaMutedTextColor}" />
    <SolidColorBrush x:Key="PediaDisabledTextBrush" Color="{StaticResource PediaDisabledTextColor}" />
    <SolidColorBrush x:Key="PediaFocusBrush" Color="{StaticResource PediaFocusColor}" />

    <!-- Standard control resources are deliberately neutralized so the system accent never leaks into normal UI. -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource PediaFocusColor}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FFBABABA" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF888888" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#FF636363" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource PediaPrimaryTextColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource PediaSecondaryTextColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{StaticResource PediaMutedTextColor}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource PediaApplicationBackgroundColor}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="{StaticResource PediaPrimaryPaneColor}" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource PediaElevatedSurfaceColor}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource PediaSecondarySurfaceColor}" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{StaticResource PediaPointerOverColor}" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="{StaticResource PediaElevatedSurfaceColor}" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="{StaticResource PediaSecondarySurfaceColor}" />
    <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="{StaticResource PediaSecondaryTextColor}" />
    <SolidColorBrush x:Key="ControlStrongFillColorDisabledBrush" Color="{StaticResource PediaDisabledTextColor}" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource PediaPrimaryBorderColor}" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{StaticResource PediaSubtleDividerColor}" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentDefaultBrush" Color="{StaticResource PediaApplicationBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource PediaSecondarySurfaceColor}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource PediaPrimaryBorderColor}" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource PediaPrimaryPaneColor}" />
    <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush" Color="{StaticResource PediaPrimaryPaneColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource PediaApplicationBackgroundColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource PediaPrimaryPaneColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource PediaSecondarySurfaceColor}" />
    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource PediaPointerOverColor}" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource PediaSelectedColor}" />
    <SolidColorBrush x:Key="SubtleFillColorDisabledBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource PediaPrimaryTextColor}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource PediaSecondaryTextColor}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource PediaMutedTextColor}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{StaticResource PediaDisabledTextColor}" />
    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{StaticResource PediaSelectedColor}" />
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="{StaticResource PediaFocusColor}" />
    <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="{StaticResource PediaApplicationBackgroundColor}" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{StaticResource PediaSelectedColor}" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{StaticResource PediaPressedColor}" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{StaticResource PediaPressedColor}" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="{StaticResource PediaSelectedColor}" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="{StaticResource PediaPressedColor}" />
    <SolidColorBrush x:Key="HyperlinkForeground" Color="{StaticResource PediaPrimaryTextColor}" />
    <SolidColorBrush x:Key="HyperlinkForegroundPointerOver" Color="White" />
    <SolidColorBrush x:Key="HyperlinkForegroundPressed" Color="{StaticResource PediaSecondaryTextColor}" />
    <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="{StaticResource PediaElevatedSurfaceColor}" />
    <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="{StaticResource PediaElevatedSurfaceColor}" />
    <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="{StaticResource PediaElevatedSurfaceColor}" />
    <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="{StaticResource PediaElevatedSurfaceColor}" />
    <SolidColorBrush x:Key="InfoBarErrorSeverityIconBackground" Color="{StaticResource PediaSecondaryTextColor}" />
    <SolidColorBrush x:Key="InfoBarWarningSeverityIconBackground" Color="{StaticResource PediaSecondaryTextColor}" />
    <SolidColorBrush x:Key="InfoBarSuccessSeverityIconBackground" Color="{StaticResource PediaSecondaryTextColor}" />
    <SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="{StaticResource PediaSecondaryTextColor}" />
    <SolidColorBrush x:Key="InfoBarErrorSeverityIconForeground" Color="{StaticResource PediaApplicationBackgroundColor}" />
    <SolidColorBrush x:Key="InfoBarWarningSeverityIconForeground" Color="{StaticResource PediaApplicationBackgroundColor}" />
    <SolidColorBrush x:Key="InfoBarSuccessSeverityIconForeground" Color="{StaticResource PediaApplicationBackgroundColor}" />
    <SolidColorBrush x:Key="InfoBarInformationalSeverityIconForeground" Color="{StaticResource PediaApplicationBackgroundColor}" />

    <Thickness x:Key="PediaPanePadding">16,14</Thickness>
    <Thickness x:Key="PediaCompactPadding">10,6</Thickness>
    <x:Double x:Key="PediaControlMinHeight">32</x:Double>
    <x:Double x:Key="PediaInputMinHeight">34</x:Double>
    <x:Double x:Key="PediaListItemMinHeight">40</x:Double>
    <x:Double x:Key="PediaTreeItemMinHeight">34</x:Double>
    <Thickness x:Key="PediaButtonPadding">10,5</Thickness>
    <CornerRadius x:Key="PediaControlCornerRadius">4</CornerRadius>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource PediaPrimaryTextBrush}" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="MinHeight" Value="{ThemeResource PediaControlMinHeight}" />
        <Setter Property="Padding" Value="{ThemeResource PediaButtonPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource PediaControlCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="{ThemeResource PediaControlMinHeight}" />
        <Setter Property="Padding" Value="{ThemeResource PediaButtonPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource PediaControlCornerRadius}" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="{ThemeResource PediaInputMinHeight}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="{StaticResource PediaControlCornerRadius}" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="{ThemeResource PediaInputMinHeight}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="{StaticResource PediaControlCornerRadius}" />
    </Style>
    <Style TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="{ThemeResource PediaListItemMinHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>
    <Style TargetType="TreeViewItem">
        <Setter Property="MinHeight" Value="{ThemeResource PediaTreeItemMinHeight}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="PediaPaneHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PediaPrimaryTextBrush}" />
    </Style>
    <Style x:Key="PediaMetadataTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource PediaSecondaryTextBrush}" />
    </Style>
    <Style x:Key="PediaMutedTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource PediaMutedTextBrush}" />
    </Style>
    <Style x:Key="PediaArticleTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cambria" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="LineHeight" Value="44" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource PediaPrimaryTextBrush}" />
    </Style>
    <Style x:Key="PediaSectionHeadingTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cambria" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="LineHeight" Value="31" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource PediaPrimaryTextBrush}" />
    </Style>
    <Style x:Key="PediaIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style x:Key="PediaTitleBarCommandStyle" TargetType="Button">
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="74" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="PediaToolbarButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="PediaDividerStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PediaSubtleDividerBrush}" />
    </Style>
</ResourceDictionary>
