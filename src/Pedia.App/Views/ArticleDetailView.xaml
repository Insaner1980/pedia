<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Pedia.Views.ArticleDetailView"
    x:Name="RootDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Pedia.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Pedia.Models"
    d:DesignHeight="800"
    d:DesignWidth="750"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
        <converters:HeadingLevelToFontSizeConverter x:Key="HeadingLevelToFontSize" />
        <converters:DateTimeOffsetToStringConverter x:Key="DateToString" />
        <converters:StoredValueToDisplayConverter x:Key="StoredValueToDisplay" />
    </UserControl.Resources>

    <Grid Background="{ThemeResource PediaPrimaryPaneBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Padding="10,6,10,5"
            Background="{ThemeResource PediaPrimaryPaneBrush}"
            BorderBrush="{ThemeResource PediaSubtleDividerBrush}"
            BorderThickness="0,0,0,1"
            ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind ViewModel.IsReading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Button
                    Command="{x:Bind ViewModel.EditCommand}"
                    Style="{StaticResource PediaToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE70F;" />
                        <TextBlock x:Uid="EditButton" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                    Style="{StaticResource PediaToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE734;" />
                        <TextBlock x:Uid="FavoriteButton" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <ProgressRing
                Grid.Column="1"
                Width="22"
                Height="22"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            <Button
                x:Uid="ArticleActionsButton"
                Grid.Column="2"
                Style="{StaticResource PediaIconButtonStyle}"
                Visibility="{x:Bind ViewModel.IsReading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <FontIcon Glyph="&#xE712;" />
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Uid="EditArticleMenuItem" Command="{x:Bind ViewModel.EditCommand}" Icon="Edit" />
                        <MenuFlyoutItem x:Uid="DuplicateArticleMenuItem" Command="{x:Bind ViewModel.DuplicateCommand}" />
                        <MenuFlyoutItem x:Uid="FavoriteArticleMenuItem" Command="{x:Bind ViewModel.ToggleFavoriteCommand}" />
                        <MenuFlyoutItem x:Uid="ExportArticleMenuItem" Command="{x:Bind ViewModel.ExportCommand}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="TrashArticleMenuItem" Command="{x:Bind ViewModel.MoveToTrashCommand}" />
                        <MenuFlyoutItem x:Uid="RestoreArticleMenuItem" Command="{x:Bind ViewModel.RestoreCommand}" />
                        <MenuFlyoutItem x:Uid="DeleteForeverArticleMenuItem" Command="{x:Bind ViewModel.DeletePermanentlyCommand}" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                Visibility="{x:Bind ViewModel.HasArticle, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                <FontIcon Glyph="&#xE8A5;" FontSize="30" Foreground="{ThemeResource PediaMutedTextBrush}" />
                <TextBlock x:Uid="SelectArticleEmptyState" Style="{StaticResource PediaMutedTextStyle}" />
            </StackPanel>

            <TabView
                x:Name="ReaderTabs"
                IsAddTabButtonVisible="False"
                CanDragTabs="False"
                TabWidthMode="SizeToContent"
                Visibility="{x:Bind ViewModel.IsReading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <TabViewItem x:Uid="ReadTab" IsClosable="False">
                    <ScrollViewer
                        x:Name="ArticleScrollViewer"
                        VerticalScrollBarVisibility="Auto"
                        ViewChanged="OnReaderViewChanged">
                        <StackPanel
                            MaxWidth="{x:Bind ViewModel.MaximumReadingWidth, Mode=OneWay}"
                            Margin="26,22,26,64"
                            HorizontalAlignment="Left"
                            Spacing="14">
                            <TextBlock
                                Style="{StaticResource PediaArticleTitleTextStyle}"
                                Text="{x:Bind ViewModel.Article.Title, Mode=OneWay}"
                                IsTextSelectionEnabled="True" />
                            <TextBlock
                                FontFamily="Segoe UI Variable Text, Segoe UI"
                                FontSize="17"
                                Foreground="{ThemeResource PediaSecondaryTextBrush}"
                                Text="{x:Bind ViewModel.Article.Subtitle, Mode=OneWay}"
                                TextWrapping="Wrap"
                                IsTextSelectionEnabled="True"
                                Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StringToVisibility}}" />
                            <TextBlock
                                FontSize="15"
                                FontStyle="Italic"
                                Foreground="{ThemeResource PediaSecondaryTextBrush}"
                                Text="{x:Bind ViewModel.Article.Summary, Mode=OneWay}"
                                TextWrapping="Wrap"
                                IsTextSelectionEnabled="True"
                                Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StringToVisibility}}" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE774;" FontSize="13" Foreground="{ThemeResource PediaMutedTextBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.LanguageDisplay, Mode=OneWay}" Style="{StaticResource PediaMetadataTextStyle}" />
                                </StackPanel>
                                <Border Width="1" Height="16" Background="{ThemeResource PediaSubtleDividerBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.WordCountDisplay, Mode=OneWay}" Style="{StaticResource PediaMetadataTextStyle}" />
                                <Border Width="1" Height="16" Background="{ThemeResource PediaSubtleDividerBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.UpdatedDisplay, Mode=OneWay}" Style="{StaticResource PediaMetadataTextStyle}" />
                                <Border Width="1" Height="16" Background="{ThemeResource PediaSubtleDividerBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.TopicsCountDisplay, Mode=OneWay}" Style="{StaticResource PediaMetadataTextStyle}" />
                                <Border Width="1" Height="16" Background="{ThemeResource PediaSubtleDividerBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SourcesCountDisplay, Mode=OneWay}" Style="{StaticResource PediaMetadataTextStyle}" />
                            </StackPanel>
                            <Border Height="1" Margin="0,2,0,5" Background="{ThemeResource PediaSubtleDividerBrush}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Article.Sections, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ArticleSectionData">
                                        <StackPanel Margin="0,0,0,20" Spacing="8">
                                            <TextBlock
                                                FontFamily="Cambria"
                                                FontSize="{x:Bind HeadingLevel, Converter={StaticResource HeadingLevelToFontSize}}"
                                                Foreground="{ThemeResource PediaPrimaryTextBrush}"
                                                Text="{x:Bind Heading}"
                                                TextWrapping="Wrap"
                                                IsTextSelectionEnabled="True"
                                                Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StringToVisibility}}" />
                                            <TextBlock
                                                FontFamily="Segoe UI Variable Text, Segoe UI"
                                                FontSize="{Binding ViewModel.ArticleBodyFontSize, ElementName=RootDetailView}"
                                                LineHeight="{Binding ViewModel.ArticleLineSpacing, ElementName=RootDetailView}"
                                                Foreground="{ThemeResource PediaPrimaryTextBrush}"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind Body}"
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <TabViewItem x:Uid="MetadataTab" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid MaxWidth="820" Margin="26,22,26,48" HorizontalAlignment="Left" ColumnSpacing="24" RowSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" MinWidth="300" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Uid="TitleLabel" Style="{StaticResource PediaMutedTextStyle}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Article.Title, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock x:Uid="SubtitleLabel" Grid.Row="1" Style="{StaticResource PediaMutedTextStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Article.Subtitle, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock x:Uid="SummaryLabel" Grid.Row="2" Style="{StaticResource PediaMutedTextStyle}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.Article.Summary, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock x:Uid="LanguageLabel" Grid.Row="3" Style="{StaticResource PediaMutedTextStyle}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.LanguageDisplay, Mode=OneWay}" IsTextSelectionEnabled="True" />
                            <TextBlock x:Uid="TypeLabel" Grid.Row="4" Style="{StaticResource PediaMutedTextStyle}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.ArticleTypeDisplay, Mode=OneWay}" />
                            <TextBlock x:Uid="StatusLabel" Grid.Row="5" Style="{StaticResource PediaMutedTextStyle}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.StatusDisplay, Mode=OneWay}" />
                            <TextBlock x:Uid="FavoriteLabel" Grid.Row="6" Style="{StaticResource PediaMutedTextStyle}" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind ViewModel.FavoriteDisplay, Mode=OneWay}" />
                            <TextBlock x:Uid="WordCountLabel" Grid.Row="7" Style="{StaticResource PediaMutedTextStyle}" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{x:Bind ViewModel.WordCountDisplay, Mode=OneWay}" />
                            <TextBlock x:Uid="CreatedLabel" Grid.Row="8" Style="{StaticResource PediaMutedTextStyle}" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{x:Bind ViewModel.Article.CreatedAtUtc, Mode=OneWay, Converter={StaticResource DateToString}}" />
                            <TextBlock x:Uid="UpdatedLabel" Grid.Row="9" Style="{StaticResource PediaMutedTextStyle}" />
                            <TextBlock Grid.Row="9" Grid.Column="1" Text="{x:Bind ViewModel.Article.UpdatedAtUtc, Mode=OneWay, Converter={StaticResource DateToString}}" />
                            <TextBlock x:Uid="InternalIdLabel" Grid.Row="10" Style="{StaticResource PediaMutedTextStyle}" />
                            <TextBlock Grid.Row="10" Grid.Column="1" Text="{x:Bind ViewModel.Article.Id, Mode=OneWay}" IsTextSelectionEnabled="True" />
                            <TextBlock x:Uid="NotesLabel" Grid.Row="11" Style="{StaticResource PediaMutedTextStyle}" />
                            <TextBlock Grid.Row="11" Grid.Column="1" Text="{x:Bind ViewModel.Article.Notes, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </Grid>
                    </ScrollViewer>
                </TabViewItem>

                <TabViewItem x:Uid="SourceTab" IsClosable="False">
                    <Grid Margin="18,14,18,36">
                        <TextBlock
                            x:Uid="NoSourcesText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource PediaMutedTextStyle}"
                            Visibility="{x:Bind ViewModel.HasSources, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ListView ItemsSource="{x:Bind ViewModel.Article.Sources, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ArticleSourceData">
                                    <Border Padding="14" BorderBrush="{ThemeResource PediaSubtleDividerBrush}" BorderThickness="0,0,0,1">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind SourceType, Converter={StaticResource StoredValueToDisplay}}" Style="{StaticResource PediaMetadataTextStyle}" />
                                                <TextBlock Text="{x:Bind Url}" Style="{StaticResource PediaMutedTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                 <TextBlock Text="{x:Bind AttributionText}" Style="{StaticResource PediaMetadataTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                 <TextBlock Text="{x:Bind LicenseName}" Style="{StaticResource PediaMetadataTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                 <TextBlock Text="{x:Bind ExternalPageId}" Style="{StaticResource PediaMutedTextStyle}" IsTextSelectionEnabled="True" />
                                                 <TextBlock Text="{x:Bind ExternalRevisionId}" Style="{StaticResource PediaMutedTextStyle}" IsTextSelectionEnabled="True" />
                                                 <TextBlock Text="{x:Bind RetrievedAtUtc, Converter={StaticResource DateToString}}" Style="{StaticResource PediaMutedTextStyle}" />
                                                 <TextBlock Text="{x:Bind LastCheckedAtUtc, Converter={StaticResource DateToString}}" Style="{StaticResource PediaMutedTextStyle}" />
                                                <TextBlock Text="{x:Bind Notes}" Style="{StaticResource PediaMutedTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </StackPanel>
                                            <Button x:Uid="CopySourceButton" Grid.Column="1" Click="OnCopySourceClick" IsEnabled="{x:Bind HasValidUrl}" Style="{StaticResource PediaToolbarButtonStyle}" />
                                            <Button x:Uid="OpenSourceButton" Grid.Column="2" Click="OnOpenSourceClick" IsEnabled="{x:Bind HasValidUrl}" Style="{StaticResource PediaToolbarButtonStyle}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </TabViewItem>

                <TabViewItem x:Uid="TopicsTab" IsClosable="False">
                    <Grid Margin="18,14,18,36">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Button
                            x:Uid="ManageTopicsButton"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Right"
                            Command="{x:Bind ViewModel.ManageTopicsCommand}"
                            Style="{StaticResource PediaToolbarButtonStyle}" />
                        <TextBlock
                            x:Uid="NoTopicsText"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource PediaMutedTextStyle}"
                            Visibility="{x:Bind ViewModel.HasTopics, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Article.Topics, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ArticleTopicData">
                                    <Grid MinHeight="44" Padding="12,6" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource PediaSecondaryTextBrush}" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}" />
                                        <RadioButton
                                            x:Uid="ReaderPrimaryTopicButton"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Click="OnSetReaderPrimaryTopicClick"
                                            IsEnabled="{Binding ViewModel.CanModifyReaderTopics, ElementName=RootDetailView}"
                                            IsChecked="{x:Bind IsPrimary}" />
                                        <Button
                                            x:Uid="ReaderRemoveTopicAssignmentButton"
                                            Grid.Column="3"
                                            Click="OnRemoveReaderTopicAssignmentClick"
                                            IsEnabled="{Binding ViewModel.CanModifyReaderTopics, ElementName=RootDetailView}"
                                            Style="{StaticResource PediaIconButtonStyle}">
                                            <FontIcon Glyph="&#xE74D;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </TabViewItem>
            </TabView>

            <Grid Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="900" Margin="24,18,24,36" HorizontalAlignment="Left" Spacing="16">
                        <TextBlock
                            x:Uid="EditArticleHeader"
                            FontSize="22"
                            FontWeight="SemiBold" />
                        <TextBox x:Name="TitleField" x:Uid="TitleField" Text="{x:Bind ViewModel.Editor.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" />
                        <TextBox x:Uid="SubtitleField" Text="{x:Bind ViewModel.Editor.Subtitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" />
                        <TextBox x:Uid="SummaryField" Text="{x:Bind ViewModel.Editor.Summary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Uid="LanguageField" Text="{x:Bind ViewModel.Editor.LanguageCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="35" />
                            <ComboBox x:Uid="ArticleTypeField" Grid.Column="1" ItemsSource="{x:Bind ViewModel.ArticleTypes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{x:Bind ViewModel.Editor.ArticleType, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                            <ComboBox x:Uid="ArticleStatusField" Grid.Column="2" ItemsSource="{x:Bind ViewModel.ArticleStatuses}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{x:Bind ViewModel.Editor.Status, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                            <CheckBox x:Uid="FavoriteField" Grid.Column="3" VerticalAlignment="Bottom" IsChecked="{x:Bind ViewModel.Editor.IsFavorite, Mode=TwoWay}" />
                        </Grid>
                        <TextBox x:Uid="NotesField" Text="{x:Bind ViewModel.Editor.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />

                        <Grid Margin="0,6,0,0">
                            <TextBlock x:Uid="SectionsHeader" Style="{StaticResource PediaPaneHeaderTextStyle}" />
                            <Button x:Uid="AddSectionButton" HorizontalAlignment="Right" Command="{x:Bind ViewModel.AddSectionCommand}" Style="{StaticResource PediaToolbarButtonStyle}" />
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Editor.Sections, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:EditableSection">
                                    <Border Margin="0,0,0,10" Padding="12" Background="{ThemeResource PediaSecondarySurfaceBrush}" BorderBrush="{ThemeResource PediaPrimaryBorderBrush}" BorderThickness="1" CornerRadius="4">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Uid="SectionHeadingField" Text="{x:Bind Heading, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <ComboBox x:Uid="SectionLevelField" Grid.Column="1" ItemsSource="{Binding ViewModel.HeadingLevels, ElementName=RootDetailView}" SelectedItem="{x:Bind HeadingLevel, Mode=TwoWay}" />
                                                <Button x:Uid="MoveSectionUpButton" Grid.Column="2" Command="{Binding ViewModel.MoveSectionUpCommand, ElementName=RootDetailView}" CommandParameter="{x:Bind}" Style="{StaticResource PediaIconButtonStyle}"><FontIcon Glyph="&#xE74A;" /></Button>
                                                <Button x:Uid="MoveSectionDownButton" Grid.Column="3" Command="{Binding ViewModel.MoveSectionDownCommand, ElementName=RootDetailView}" CommandParameter="{x:Bind}" Style="{StaticResource PediaIconButtonStyle}"><FontIcon Glyph="&#xE74B;" /></Button>
                                                <Button x:Uid="DeleteSectionButton" Grid.Column="4" Click="OnDeleteSectionClick" Style="{StaticResource PediaIconButtonStyle}"><FontIcon Glyph="&#xE74D;" /></Button>
                                            </Grid>
                                            <TextBox x:Uid="SectionBodyField" Text="{x:Bind Body, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="130" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,6,0,0">
                            <TextBlock x:Uid="SourcesHeader" Style="{StaticResource PediaPaneHeaderTextStyle}" />
                            <Button x:Uid="AddSourceButton" HorizontalAlignment="Right" Command="{x:Bind ViewModel.AddSourceCommand}" Style="{StaticResource PediaToolbarButtonStyle}" />
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Editor.Sources, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:EditableSource">
                                    <Border Margin="0,0,0,10" Padding="12" Background="{ThemeResource PediaSecondarySurfaceBrush}" BorderBrush="{ThemeResource PediaPrimaryBorderBrush}" BorderThickness="1" CornerRadius="4">
                                        <Grid ColumnSpacing="10" RowSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <ComboBox x:Uid="SourceTypeField" ItemsSource="{Binding ViewModel.SourceTypes, ElementName=RootDetailView}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{x:Bind SourceType, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                            <TextBox x:Uid="SourceTitleField" Grid.Column="1" Text="{x:Bind Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button x:Uid="MoveSourceUpButton" Grid.Column="2" Command="{Binding ViewModel.MoveSourceUpCommand, ElementName=RootDetailView}" CommandParameter="{x:Bind}" Style="{StaticResource PediaIconButtonStyle}"><FontIcon Glyph="&#xE74A;" /></Button>
                                            <Button x:Uid="MoveSourceDownButton" Grid.Column="3" Command="{Binding ViewModel.MoveSourceDownCommand, ElementName=RootDetailView}" CommandParameter="{x:Bind}" Style="{StaticResource PediaIconButtonStyle}"><FontIcon Glyph="&#xE74B;" /></Button>
                                            <Button x:Uid="DeleteSourceButton" Grid.Column="4" Click="OnDeleteSourceClick" Style="{StaticResource PediaIconButtonStyle}"><FontIcon Glyph="&#xE74D;" /></Button>
                                            <TextBox x:Uid="SourceUrlField" Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox x:Uid="ExternalPageIdField" Grid.Row="2" Text="{x:Bind ExternalPageId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox x:Uid="ExternalRevisionIdField" Grid.Row="2" Grid.Column="1" Text="{x:Bind ExternalRevisionId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox x:Uid="LicenseField" Grid.Row="3" Text="{x:Bind LicenseName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox x:Uid="AttributionField" Grid.Row="3" Grid.Column="1" Text="{x:Bind AttributionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <DatePicker x:Uid="RetrievedField" Grid.Row="4" SelectedDate="{x:Bind RetrievedAtUtc, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                            <DatePicker x:Uid="LastCheckedField" Grid.Row="4" Grid.Column="1" SelectedDate="{x:Bind LastCheckedAtUtc, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                            <TextBox x:Uid="SourceNotesField" Grid.Row="5" Grid.ColumnSpan="2" Text="{x:Bind Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,6,0,0">
                            <TextBlock x:Uid="AssignedTopicsHeader" Style="{StaticResource PediaPaneHeaderTextStyle}" />
                            <Button x:Uid="AddTopicsButton" HorizontalAlignment="Right" Command="{x:Bind ViewModel.AddTopicsCommand}" Style="{StaticResource PediaToolbarButtonStyle}" />
                        </Grid>
                        <ListView ItemsSource="{x:Bind ViewModel.Editor.Topics, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:EditableTopicAssignment">
                                    <Grid MinHeight="40" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" />
                                        <RadioButton x:Uid="EditorPrimaryTopicButton" Grid.Column="1" IsChecked="{x:Bind IsPrimary, Mode=OneWay}" Click="OnSetPrimaryTopicClick" />
                                        <Button x:Uid="RemoveTopicAssignmentButton" Grid.Column="2" Click="OnRemoveTopicAssignmentClick" Style="{StaticResource PediaIconButtonStyle}"><FontIcon Glyph="&#xE74D;" /></Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="1" Padding="14,8" Background="{ThemeResource PediaElevatedSurfaceBrush}" BorderBrush="{ThemeResource PediaPrimaryBorderBrush}" BorderThickness="0,1,0,0">
                    <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource PediaSecondaryTextBrush}" Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StringToVisibility}}" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="CancelEditButton" Command="{x:Bind ViewModel.CancelEditCommand}" />
                        <Button x:Uid="SaveArticleButton" Command="{x:Bind ViewModel.SaveCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
